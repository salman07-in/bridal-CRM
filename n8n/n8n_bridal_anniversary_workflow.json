{
  "name": "Safiya's Makeover — Bridal Anniversary Daily Reminder Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 3 * * *"
            }
          ]
        }
      },
      "id": "1",
      "name": "Daily Trigger (09:00 AM IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://bridal.safiyasmakeover.com/api/v1/reminders/due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2",
      "name": "Fetch Due Anniversaries",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "3",
      "name": "Any Reminders Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "4",
      "name": "Itemize Reminders",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [
        920,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.customer.whatsapp_consent }}",
              "value2": true
            }
          ]
        }
      },
      "id": "5",
      "name": "Bride WhatsApp Consent Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1140,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"91{{ $json.customer.clean_phone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"anniversary_greeting_v1\",\n    \"language\": { \"code\": \"en\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": \"{{ $json.customer.full_name }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.customer.years_married }}\" },\n          { \"type\": \"text\", \"text\": \"Safiya's Makeover\" }\n        ]\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "6",
      "name": "Dispatch WhatsApp Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bridal.safiyasmakeover.com/api/v1/reminders/mark-sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $env.CRM_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"reminder_id\": {{ $('Itemize Reminders').item.json.reminder_id }},\n  \"idempotency_key\": \"{{ $('Itemize Reminders').item.json.idempotency_key }}\",\n  \"metadata\": \"Dispatched via n8n automation\"\n}",
        "options": {}
      },
      "id": "7",
      "name": "Mark Sent in CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1640,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bridal.safiyasmakeover.com/api/v1/reminders/trigger-daily",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $env.CRM_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "8",
      "name": "Send Owner Daily Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        420
      ]
    }
  ],
  "connections": {
    "Daily Trigger (09:00 AM IST)": {
      "main": [
        [
          {
            "node": "Fetch Due Anniversaries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Due Anniversaries": {
      "main": [
        [
          {
            "node": "Any Reminders Due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Reminders Due?": {
      "main": [
        [
          {
            "node": "Itemize Reminders",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Owner Daily Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Itemize Reminders": {
      "main": [
        [
          {
            "node": "Bride WhatsApp Consent Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Bride WhatsApp Consent Check": {
      "main": [
        [
          {
            "node": "Dispatch WhatsApp Template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch WhatsApp Template": {
      "main": [
        [
          {
            "node": "Mark Sent in CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  }
}
