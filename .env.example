# Safiya's Makeover - Bridal CRM Environment Configuration
# Copy this file to .env and replace placeholders with secure production values

# Application Environment (development, production, testing)
FLASK_ENV=production
DEBUG=False

# Secret Key (Generate using: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production

# Database Configuration (Relative to project root or absolute path)
# In production, recommend: sqlite:////var/www/safiya-crm/instance/safiya_crm.sqlite3
DATABASE_URL=sqlite:///instance/safiya_crm.sqlite3

# Timezone Setting (Required: Asia/Kolkata for Indian Standard Time)
TIMEZONE=Asia/Kolkata

# Admin Seed Account (Used on initial database bootstrap)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@safiyasmakeover.com
DEFAULT_ADMIN_PASSWORD=ChangeMeNowSecure123!

# Salon Brand & Information
SALON_NAME="Safiya's Makeover"
SALON_TAGLINE="Luxury Bridal & Makeover Studio"
SALON_BRANCH="Main Branch"
SALON_PHONE="+91 98765 43210"
SALON_OWNER_EMAIL=owner@safiyasmakeover.com

# Reminder Rules
REMINDER_ADVANCE_DAYS=7
SEND_OWNER_DAILY_DIGEST=True
OWNER_DIGEST_TIME="09:00"

# SMTP Email Configuration
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_USERNAME=notifications@safiyasmakeover.com
SMTP_PASSWORD=your-app-password-or-smtp-token
SMTP_FROM_EMAIL=notifications@safiyasmakeover.com
SMTP_FROM_NAME="Safiya's Makeover Studio"

# API Authentication for n8n & Automated Jobs
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
CRM_API_KEY=replace-with-a-random-secure-api-key-for-n8n

# WhatsApp Cloud API (Optional - Official Meta Business API)
WHATSAPP_ENABLED=False
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=anniversary_greeting_v1

# Security & Cookies (Set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=28800

# Rate Limiting Storage
RATELIMIT_STORAGE_URI=memory://
